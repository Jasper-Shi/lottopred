# Optional email notifications. Leave unset to disable email delivery.
# These are the only two required values for Gmail.
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-google-app-password

# Optional overrides. Defaults are shown below.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=your-account@gmail.com
# EMAIL_TO=your-account@gmail.com
